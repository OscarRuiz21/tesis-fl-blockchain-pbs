# Variables de infraestructura para docker compose y los scripts de shell.
# La configuración de cada experimento vive en experiments/*.yml; Java no lee
# este archivo.

# Compose
COMPOSE_PROJECT_NAME=fl-pbs
FABRIC_VERSION=2.5

# Política de endorsement del chaincode. Es single-org porque el chaincode
# devuelve tiempos medidos en cada invocación y dos peers no producirían la
# misma respuesta, de modo que AND(Org1, Org2) fallaría. Moverlos a una
# consulta aparte permitiría el endorsement multi-org.
ENDORSEMENT_POLICY="OR('Org2MSP.peer')"

# CN del certificado mTLS autorizado a invocar POST /admin/init en el AS.
# Debe coincidir con el del coordinator (scripts/gen-certs.sh).
AUTH_ADMIN_CN=coordinator

# Puertos del host
AUTH_SERVER_PORT=8443
COORDINATOR_PORT=9100

# Timeout del experimento en segundos (curl --max-time de run-experiment.sh)
TIMEOUT_EXPERIMENT=3600
